<?xml version="1.0" encoding="UTF-8"?>

<webpage lastModified="$Date$" id="dozbib">
 <title xml:lang="de">Willkommen bei der Hochschulbibliografie der MHH</title>
 <title xml:lang="en">Welcome to Bibliography of the MHH</title>

 <article class="card mb-3" xml:lang="de">
   <div class="card-body">
     <h3>Die Hochschulbibliografie HoBi</h3>
      <p>
        Beginnend mit dem Jahr 2008 erfasst die Bibliothek alle Publikationen von MHH-Angehörigen. Die
        erhobenen Daten dienen neben der Berechnung der leistungsorientierten Mittelvergabe (LOM) seitens
        des Präsidiums dem Aufbau einer Hochschulbibliografie der MHH.
      </p>
      <p>
        Die Publikationen, die in der Hochschulbibliografie gemeldet werden, werden zudem in das
        <a href="https://www.mhh.de/forschung/fis">Forschungsinformationssystem</a> der MHH importiert.
        Hier gilt, je aktueller die Publikationen gemeldet
        werden, desto aktueller werden diese im Forschungsinformationssystem ausgegeben.
      </p>
      <p>
        Die <a href="https://webext.mh-hannover.de/bib/lom/index.php">Meldung neuer Publikationen</a> erfolgt
        mittels automatischen Datentransfers aus <a href="https://pubmed.ncbi.nlm.nih.gov/?otool=idemhhlib">PubMed</a>
        mit dem MHH-Linksystem oder manuell über das Erfassungsformular Meldung neuer Publikationen.
      </p>
   </div>
 </article>
 <article class="card mb-3" xml:lang="en">
    <div class="card-body">
      <h3>The University Bibliography HoBi</h3>
      <p>
        Since 2008, the library has been recording all publications by members of Hannover Medical School (MHH).
        The collected data are used both for calculating the performance-based funding allocation (LOM) by the
        university administration and for building the MHH University Bibliography.
      </p>
      <p>
        Publications reported to the University Bibliography are also imported into the
        <a href="https://www.mhh.de/forschung/fis">Research Information System</a> of MHH.
        The more promptly publications are reported, the more up-to-date the information displayed in the
        Research Information System will be.
      </p>
      <p>
        <a href="https://webext.mh-hannover.de/bib/lom/index.php">Reporting new publications</a> can be done
        automatically via data transfer from <a href="https://pubmed.ncbi.nlm.nih.gov/?otool=idemhhlib">PubMed</a>
        using the MHH link system, or manually through the submission form for reporting new publications.
      </p>
    </div>
  </article>

  <article class="card mb-3">
    <div class="card-body">
      <xed:form xmlns:xed="http://www.mycore.de/xeditor" method="post" role="form">
        <div class="form-group form-inline mb-0">

          <xed:bind xpath="/query">
            <xed:bind xpath="@mask" default="index.xed" />
            <xed:bind xpath="@numPerPage" default="10" />
            <xed:bind xpath="conditions[@format='xml']/boolean[@operator='and']">
              <xed:bind xpath="condition[@field='all'][@operator='contains']/@value">
                <label for="input" class="mycore-form-label">
                  <xed:output i18n="ubo.search.simple" />
                </label>
                <input id="input" type="text" class="mycore-form-input form-control-sm mr-2" />
              </xed:bind>

              <!-- Standard users must only find confirmed publications, admins find all publications -->
              <xed:choose>
                <xed:when test="not(xed:call-java('org.mycore.ubo.AccessControl','currentUserIsAdmin'))">
                  <xed:bind xpath="condition[@field='status'][@operator='='][@value='confirmed']" />
                </xed:when>
                <xed:otherwise>
                  <xed:bind xpath="condition[@field='objectType'][@operator='='][@value='mods']" />
                </xed:otherwise>
              </xed:choose>

            </xed:bind>

            <xed:bind xpath="sortBy[field[@name='year'][@order='descending']]" />

          </xed:bind>

          <button class="btn btn-sm btn-primary" type="submit" xed:target="servlet" xed:href="MCRQLSearchServlet">
            <xed:output i18n="button.search" />
          </button>

        </div>
      </xed:form>
    </div>
  </article>

  <xinclude uri="xslStyle:response-newest:solr:q=status%3Aconfirmed+AND+year%3A2022&amp;rows=4&amp;sort=created+desc,year+desc&amp;facet=false&amp;fl=id,year" />

  <aside id="sidebar">
    <xinclude uri="xslStyle:response-sidebar-mini:solr:q=status%3Aconfirmed&amp;rows=0" />
    <xinclude uri="xslStyle:response-sidebar-admin:solr:q=*%3A*&amp;rows=0&amp;facet=true&amp;facet.field=status&amp;facet.mincount=0&amp;facet.range=created&amp;facet.range=modified&amp;facet.range.start=NOW/DAY-30DAY&amp;facet.range.end=NOW&amp;facet.range.gap=%2B1DAY" />
    <xinclude uri="xslStyle:response-sidebar-admin:solr:q=status%3Aimported+AND+importID%3A*&amp;rows=0&amp;facet=true&amp;facet.sort=index&amp;facet.limit=-1&amp;facet.field=importID" />

